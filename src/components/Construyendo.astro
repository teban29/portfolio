<script>
  (function () {
    const section = document.getElementById("construyendo");
    if (!section) return;

    const progressBars = section.querySelectorAll(".build-progress");

    progressBars.forEach((bar) => {
      const el = bar as HTMLElement;
      const progress = el.style.getPropertyValue("--progress");
      el.style.setProperty("--progress", "0%");
      const progObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              el.style.setProperty("--progress", progress);
            }, 300);
          }
        },
        { threshold: 0.3 },
      );
      progObserver.observe(el);
    });
  })();
</script>

<style is:inline>
  .build-card,
  .build-card-full {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s, box-shadow 0.3s;
  }

  .build-card:nth-child(1) { transition-delay: 0.05s; }

  .build-card.is-visible,
  .build-card-full.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .build-progress {
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .build-card,
    .build-card-full {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .build-progress {
      transition: none;
      transform: scaleX(var(--progress)) !important;
    }
  }
</style>
