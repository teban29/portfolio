<section
  id="tecnologias"
  class="relative overflow-hidden bg-bg py-24 sm:py-32"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-14 sm:mb-20">
      <p class="mb-3 font-mono text-xs font-medium tracking-wide text-primary">
        Tecnologías
      </p>
      <h2 class="text-balance font-sans text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.12] tracking-[-0.02em] text-ink">
        Lo que uso para<br />construir
      </h2>
      <p class="mt-4 max-w-md text-base leading-relaxed text-muted">
        Herramientas modernas elegidas por una razón: resolver problemas reales, no por moda.
      </p>
    </div>

    <div class="stack-layers space-y-0">
      {
        [
          {
            label: "Frontend",
            desc: "Lo que el usuario ve y siente",
            dotClass: "bg-primary",
            techs: [
              { name: "JavaScript", icon: "/icons/tech/javascript.svg" },
              { name: "TypeScript", icon: "/icons/tech/typescritp.svg" },
              { name: "React", icon: "/icons/tech/react.svg" },
              { name: "Next.js", icon: "/icons/tech/nextjs.svg", invertDark: true },
              { name: "Astro", icon: "/icons/tech/astro.svg" },
              { name: "Tailwind CSS", icon: "/icons/tech/tailwindcss.svg" },
            ],
          },
          {
            label: "Backend",
            desc: "Lo que hace que todo funcione",
            dotClass: "bg-accent",
            techs: [
              { name: "Python", icon: "/icons/tech/python.svg" },
              { name: "Django", icon: "/icons/tech/django.svg" },
              { name: "PHP", icon: "/icons/tech/php-svgrepo-com.svg" },
              { name: "Laravel", icon: "/icons/tech/laravel.svg" },
              { name: "Go", icon: "/icons/tech/go.svg" },
              { name: "Strapi", icon: "/icons/tech/strapi.svg" },
            ],
          },
          {
            label: "DevOps",
            desc: "Lo que mantiene todo vivo",
            dotClass: "bg-muted",
            techs: [
              { name: "Docker", icon: "/icons/tech/docker.svg" },
              { name: "Linux", icon: "/icons/tech/linux.svg" },
              { name: "Git", icon: "/icons/tech/git.svg" },
              { name: "CI/CD", icon: null },
              { name: "Nginx", icon: "/icons/tech/nginx.svg" },
            ],
          },
        ].map((layer) => (
          <div class="stack-layer group relative bg-surface/25 px-5 py-7 transition-all duration-300 hover:shadow-sm sm:px-8 sm:py-8" data-reveal>
            <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-10">
              <div class="shrink-0 sm:w-36">
                <div class="flex items-center gap-2.5">
                  <span class={`inline-block h-2 w-2 shrink-0 rounded-full ${layer.dotClass}`}></span>
                  <h3 class="font-mono text-sm font-semibold tracking-wide text-ink">{layer.label}</h3>
                </div>
                <p class="mt-2 text-xs leading-relaxed text-muted">{layer.desc}</p>
              </div>
              <div class="min-w-0 flex-1">
                <div class="tech-pills-container flex flex-wrap gap-2" data-expanded="false">
                  {layer.techs.map((tech, i) => (
                    <span class:list={[
                      "tech-pill group/pill inline-flex items-center gap-2 rounded-full border border-border/50 bg-bg px-3.5 py-2 font-mono text-xs font-medium leading-none text-ink/80 transition-all duration-300 hover:border-border hover:text-ink hover:shadow-sm",
                      { "tech-pill-collapsed": i >= 4 },
                    ]}>
                      {tech.icon ? (
                        <img
                          src={tech.icon}
                          alt=""
                          width="20"
                          height="20"
                          class:list={[
                            "tech-icon h-5 w-5 opacity-60 transition-opacity group-hover/pill:opacity-100",
                            { "tech-icon-invert-dark": tech.invertDark },
                          ]}
                          loading="lazy"
                          decoding="async"
                        />
                      ) : null}
                      {tech.name}
                    </span>
                  ))}
                  {layer.techs.length > 4 && (
                    <button
                      type="button"
                      class="tech-pill-toggle inline-flex items-center gap-1 rounded-full border border-dashed border-border/70 bg-bg px-3 py-2 font-mono text-xs font-medium text-muted transition-colors hover:border-border hover:text-ink sm:hidden"
                      aria-expanded="false"
                    >
                      <span class="toggle-text">Ver más</span>
                      <span class="toggle-count">+{layer.techs.length - 4}</span>
                    </button>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

</section>

<script>
  (function () {
    const section = document.getElementById("tecnologias");
    if (!section) return;

    const pills = section.querySelectorAll(".tech-pill");

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
          }
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -30px 0px" },
    );

    pills.forEach((pill, i) => {
      pill.style.setProperty("--pill-index", String(i % 6));
      observer.observe(pill);
    });

    const toggles = section.querySelectorAll(".tech-pill-toggle");
    toggles.forEach((btn) => {
      btn.addEventListener("click", () => {
        const container = btn.closest(".tech-pills-container") as HTMLElement | null;
        if (!container) return;
        const expanded = container.getAttribute("data-expanded") === "true";
        container.setAttribute("data-expanded", String(!expanded));
        btn.setAttribute("aria-expanded", String(!expanded));
        const text = btn.querySelector(".toggle-text");
        if (text) text.textContent = expanded ? "Ver más" : "Ver menos";
      });
    });
  })();
</script>

<style is:inline>
  .stack-layers {
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .stack-layer {
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
  }

  .stack-layer:nth-child(2) { transition-delay: 0.1s; }
  .stack-layer:nth-child(3) { transition-delay: 0.2s; }

  .stack-layer.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .stack-layer:not(:last-child) {
    border-bottom: 1px solid var(--border);
  }

  .tech-pill {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s, box-shadow 0.3s;
    transition-delay: calc(0.05s + var(--pill-index, 0) * 0.04s);
  }

  .tech-pill.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tech-pill-collapsed {
    display: none;
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }

  [data-expanded="true"] .tech-pill-collapsed {
    display: inline-flex;
  }

  [data-expanded="true"] .toggle-count {
    display: none;
  }

  [data-theme="dark"] .tech-icon-invert-dark {
    filter: brightness(0) invert(1);
  }

  @media (min-width: 640px) {
    .tech-pill-collapsed {
      display: inline-flex !important;
    }

    .tech-pill-toggle {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-layer,
    .tech-pill {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
