<canvas
  id="particle-canvas"
  class="absolute inset-0 h-full w-full"
  aria-hidden="true"
></canvas>

<script>
  function initParticleNetwork() {
    const canvas = document.getElementById(
      "particle-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const isMobile = window.matchMedia("(max-width: 767px)").matches;
    const isTouchDevice = window.matchMedia("(hover: none)").matches;

    if (prefersReducedMotion || isMobile || isTouchDevice) {
      canvas.style.display = "none";
      return;
    }

    const CONFIG = {
      count: window.innerWidth < 1024 ? 20 : 32,
      connectDistance: window.innerWidth < 1024 ? 90 : 120,
      particleSize: window.innerWidth < 1024 ? 1 : 1.2,
      baseSpeed: 0.18,
      mouseRadius: 140,
      mouseForce: 0.12,
    };

    const mouse = { x: -1000, y: -1000 };
    let particles: Particle[] = [];
    let animationId = 0;
    let isVisible = true;

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
    }

    function createParticles(w: number, h: number): Particle[] {
      const arr: Particle[] = [];
      for (let i = 0; i < CONFIG.count; i++) {
        arr.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * CONFIG.baseSpeed,
          vy: (Math.random() - 0.5) * CONFIG.baseSpeed,
        });
      }
      return arr;
    }

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas!.getBoundingClientRect();
      canvas!.width = rect.width * dpr;
      canvas!.height = rect.height * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      particles = createParticles(rect.width, rect.height);
    }

    function getParticleColor(): string {
      const isDark = document.documentElement.dataset.theme === "dark";
      return isDark
        ? "oklch(0.620 0.120 160)"
        : "oklch(0.560 0.130 160)";
    }

    function draw() {
      if (!ctx || !canvas || !isVisible) {
        return;
      }

      const w = canvas.getBoundingClientRect().width;
      const h = canvas.getBoundingClientRect().height;
      const particleColor = getParticleColor();
      const particlesLength = particles.length;

      ctx.clearRect(0, 0, w, h);

      for (let i = 0; i < particlesLength; i++) {
        const p = particles[i];
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < CONFIG.mouseRadius) {
          const force =
            ((CONFIG.mouseRadius - dist) / CONFIG.mouseRadius) *
            CONFIG.mouseForce;
          p.vx += (dx / (dist + 0.01)) * force;
          p.vy += (dy / (dist + 0.01)) * force;
        }

        p.vx *= 0.995;
        p.vy *= 0.995;

        p.x += p.vx;
        p.y += p.vy;

        if (p.x < -40) p.x = w + 40;
        if (p.x > w + 40) p.x = -40;
        if (p.y < -40) p.y = h + 40;
        if (p.y > h + 40) p.y = -40;

        ctx.beginPath();
        ctx.arc(p.x, p.y, CONFIG.particleSize, 0, Math.PI * 2);
        ctx.fillStyle = particleColor;
        ctx.globalAlpha = 0.4;
        ctx.fill();
      }

      for (let i = 0; i < particlesLength; i++) {
        const pi = particles[i];
        for (let j = i + 1; j < particlesLength; j++) {
          const pj = particles[j];
          const dx = pi.x - pj.x;
          const dy = pi.y - pj.y;
          const dist = dx * dx + dy * dy;
          if (dist < CONFIG.connectDistance * CONFIG.connectDistance) {
            const alpha = 0.1 * (1 - Math.sqrt(dist) / CONFIG.connectDistance);
            ctx.beginPath();
            ctx.moveTo(pi.x, pi.y);
            ctx.lineTo(pj.x, pj.y);
            ctx.strokeStyle = particleColor;
            ctx.globalAlpha = alpha;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      ctx.globalAlpha = 1;
      animationId = requestAnimationFrame(draw);
    }

    const visibilityObserver = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry.isIntersecting;
        if (!isVisible && animationId) {
          cancelAnimationFrame(animationId);
          animationId = 0;
        } else if (isVisible && !animationId) {
          animationId = requestAnimationFrame(draw);
        }
      },
      { threshold: 0 },
    );
    visibilityObserver.observe(canvas);

    const resizeObserver = new ResizeObserver(() => resize());
    resizeObserver.observe(canvas.parentElement || canvas);

    let rafId = 0;
    let lastMouseX = -1000;
    let lastMouseY = -1000;

    document.addEventListener("mousemove", (e) => {
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      if (!rafId) {
        rafId = requestAnimationFrame(() => {
          const rect = canvas!.getBoundingClientRect();
          mouse.x = lastMouseX - rect.left;
          mouse.y = lastMouseY - rect.top;
          rafId = 0;
        });
      }
    });

    document.addEventListener("mouseleave", () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    resize();
    draw();

    return () => {
      cancelAnimationFrame(animationId);
      visibilityObserver.disconnect();
      resizeObserver.disconnect();
    };
  }

  initParticleNetwork();
</script>
